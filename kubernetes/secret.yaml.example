apiVersion: v1
kind: Secret
metadata:
  name: hostel-secret
  namespace: hostel-system
type: Opaque
stringData:
  # In production, replace this placeholder with a strong cryptographically generated secret
  SECRET_KEY: "change-this-to-a-strong-32-byte-secret-key-for-production"
  ADMIN_PASSWORD: "change-this-to-a-secure-admin-password"
