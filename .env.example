# ===================================================================
# Hostel Management System - Environment Configuration Template
# Duplicate this file to .env and customize values for your deployment.
# NEVER commit the actual .env file with real secrets to version control.
# ===================================================================

# Flask Secret Key for Session Cryptography and CSRF Token generation
# In production, generate a secure random string (e.g., using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-bytes

# Flask Runtime Environment ('development' or 'production')
FLASK_ENV=production

# Database Directory (defaults to local ./database or /app/database in Docker)
DATABASE_DIR=./database

# Optional custom database URI (e.g. sqlite:///database/hostel.db or PostgreSQL connection string)
# DATABASE_URL=sqlite:///database/hostel.db

# Initial Administrator Setup (Used only when running scripts/create_admin.py with env variables)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hostel.edu
ADMIN_PASSWORD=change-me-to-a-strong-password
